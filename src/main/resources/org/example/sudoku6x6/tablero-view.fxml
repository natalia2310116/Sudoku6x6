<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane fx:id="rootPane"
            xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.sudoku6x6.Controller.ControllerTablero">

    <!-- Barra superior con título y botón -->
    <top>
        <HBox alignment="CENTER" spacing="20">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="Sudoku 6x6"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Button fx:id="btnIniciar"
                    text="Iniciar juego"
                    style="-fx-font-size: 14px;"
                    onAction="#iniciarJuego"/>
        </HBox>
    </top>

    <!-- Tablero central -->
    <center>
        <GridPane fx:id="gridTablero"
                  hgap="5" vgap="5" alignment="CENTER">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <columnConstraints>
                <ColumnConstraints percentWidth="16.66"/>
                <ColumnConstraints percentWidth="16.66"/>
                <ColumnConstraints percentWidth="16.66"/>
                <ColumnConstraints percentWidth="16.66"/>
                <ColumnConstraints percentWidth="16.66"/>
                <ColumnConstraints percentWidth="16.66"/>
            </columnConstraints>

            <rowConstraints>
                <RowConstraints percentHeight="16.66"/>
                <RowConstraints percentHeight="16.66"/>
                <RowConstraints percentHeight="16.66"/>
                <RowConstraints percentHeight="16.66"/>
                <RowConstraints percentHeight="16.66"/>
                <RowConstraints percentHeight="16.66"/>
            </rowConstraints>
        </GridPane>
    </center>

    <!-- Pie de página -->
    <bottom>
        <HBox alignment="CENTER" spacing="15">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Button fx:id="btnReiniciar"
                    text="Reiniciar"
                    style="-fx-font-size: 14px;"
                    onAction="#reiniciarJuego"/>

            <Button fx:id="btnSalir"
                    text="Salir"
                    style="-fx-font-size: 14px;"
                    onAction="#salirJuego"/>
        </HBox>
    </bottom>

</BorderPane>
